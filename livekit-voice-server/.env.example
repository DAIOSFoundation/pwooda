# LiveKit API Keys (generate secure keys for production)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# LiveKit Server URL (use actual IP for Android device testing)
LIVEKIT_URL=ws://localhost:7880

# Auth Server URL (for token validation)
AUTH_SERVER_URL=https://api-llmops.banya.ai

# SSE Server (existing LLM/TTS server)
SSE_SERVER_URL=http://your-sse-server:8083/completion-with-tts
SSE_AUTH_TOKEN=your-sse-auth-token

# Twilio Configuration (Phone Call ↔ AI Agent)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WEBHOOK_BASE_URL=http://your-server-ip:8082
